<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <rect fill="#f5f0e6" width="400" height="300"/>
  <rect x="80" y="80" width="240" height="160" fill="#d4c4a8" stroke="#8b7355" stroke-width="2"/>
  <g font-family="serif" font-size="24" fill="#2d2d2d">
    <text x="120" y="130">A</text>
    <text x="160" y="130">B</text>
    <text x="200" y="130">C</text>
    <text x="240" y="130">文</text>
  </g>
  <text x="200" y="280" font-family="serif" font-size="12" fill="#8b7355" text-anchor="middle">活字印刷</text>
</svg>