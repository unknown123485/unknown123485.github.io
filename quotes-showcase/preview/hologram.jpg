<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <rect fill="#0a0a1a" width="400" height="300"/>
  <line x1="0" y1="150" x2="400" y2="150" stroke="#00ffff" stroke-width="1" opacity="0.3">
    <animate attributeName="y1" values="150;100;150" dur="2s" repeatCount="indefinite"/>
    <animate attributeName="y2" values="150;100;150" dur="2s" repeatCount="indefinite"/>
  </line>
  <text x="200" y="145" font-family="monospace" font-size="20" fill="#00ffff" text-anchor="middle" opacity="0.8">HOLOGRAM</text>
  <text x="200" y="170" font-family="sans-serif" font-size="12" fill="#00ffff" text-anchor="middle" opacity="0.5">全息投影</text>
</svg>