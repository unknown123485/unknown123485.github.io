<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB"/>
      <stop offset="100%" style="stop-color:#f0f8ff"/>
    </linearGradient>
  </defs>
  <rect fill="url(#sky)" width="400" height="300"/>
  <ellipse cx="100" cy="200" rx="80" ry="30" fill="#fff" opacity="0.8"/>
  <ellipse cx="300" cy="180" rx="100" ry="40" fill="#fff" opacity="0.7"/>
  <ellipse cx="200" cy="250" rx="120" ry="35" fill="#fff" opacity="0.9"/>
  <circle cx="320" cy="60" r="40" fill="#ffd700" opacity="0.8"/>
  <text x="200" y="100" font-family="serif" font-size="18" fill="#4a5568" text-anchor="middle">云端之上</text>
</svg>