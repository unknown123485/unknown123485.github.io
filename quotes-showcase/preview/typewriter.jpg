<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#2d2d44"/>
    </linearGradient>
  </defs>
  <rect fill="url(#bg)" width="400" height="300"/>
  <text x="200" y="130" font-family="monospace" font-size="16" fill="#4ade80" text-anchor="middle">打字机效果</text>
  <rect x="80" y="150" width="240" height="4" fill="#333"/>
  <rect x="80" y="150" width="80" height="4" fill="#4ade80"/>
  <rect x="160" y="150" width="2" height="12" fill="#4ade80">
    <animate attributeName="opacity" values="1;0;1" dur="1s" repeatCount="indefinite"/>
  </rect>
</svg>