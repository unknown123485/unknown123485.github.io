<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0f0f1a"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
  </defs>
  <rect fill="url(#bg)" width="400" height="300"/>
  <text x="200" y="50" font-family="sans-serif" font-size="14" fill="#00ff88" opacity="0.3">STAR WARS</text>
  <text x="200" y="100" font-family="monospace" font-size="12" fill="#00ff88" text-anchor="middle" opacity="0.5">电影滚动字幕</text>
  <line x1="50" y1="250" x2="350" y2="150" stroke="#00ff88" stroke-width="1" opacity="0.5"/>
  <text x="100" y="240" font-family="sans-serif" font-size="14" fill="#00ff88">TEXT</text>
  <text x="300" y="160" font-family="sans-serif" font-size="10" fill="#00ff88" opacity="0.5">TEXT</text>
</svg>